          <datasource-dependencies datasource='Parameters'>
            <column caption='Confidence Interval' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;99\%&quot;'>
              <calculation class='tableau' formula='&quot;99%&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bz25go0hdv5t413u1tbj0qoxn9v'>
            <column datatype='string' name='[Area of Interest]' role='dimension' type='nominal' />
            <column caption='Z Score' datatype='real' name='[Calculation_0605592214523907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;99%&quot; THEN 2.58&#13;&#10;WHEN &quot;95%&quot; THEN 1.96&#13;&#10;WHEN &quot;90%&quot; THEN 1.64&#13;&#10;END' />
            </column>
            <column caption='Marginal Error' datatype='real' name='[Calculation_0605592215093252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Calculation_0605592214523907])*(STDEV([Proportion Reproducible])/SQRT(COUNT([respid])))' />
            </column>
            <column caption='Marginal Error Left' datatype='real' name='[Calculation_0605592216264709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Proportion Reproducible])-MIN([Calculation_0605592214523907])*(STDEV([Proportion Reproducible])/SQRT(COUNT([respid])))' />
            </column>
            <column caption='Marginal Error Right' datatype='real' name='[Calculation_0605592217145350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Proportion Reproducible])+MIN([Calculation_0605592214523907])*(STDEV([Proportion Reproducible])/SQRT(COUNT([respid])))' />
            </column>
            <column datatype='real' name='[Proportion Reproducible]' role='measure' type='quantitative' />
            <column-instance column='[Proportion Reproducible]' derivation='Avg' name='[avg:Proportion Reproducible:qk]' pivot='key' type='quantitative' />
